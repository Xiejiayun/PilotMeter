{
  "name": "pilotmeter",
  "version": "0.1.0-preview.7",
  "description": "Local, privacy-conscious GitHub Copilot CLI usage meter",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.14.0"
  },
  "bin": {
    "pilotmeter": "bin/pilotmeter.js"
  },
  "files": [
    "bin",
    "dist",
    "public",
    "README.md",
    "LICENSE",
    "docs/compatibility.md",
    "docs/validation-guide.md",
    "docs/npm-package-contents.md",
    "docs/windows-exe.md"
  ],
  "scripts": {
    "build": "tsc && tsc --project web/tsconfig.json && vite build",
    "typecheck": "tsc --noEmit && tsc --project web/tsconfig.json",
    "test": "npm run build && node --test test/unit/*.test.mjs test/integration/*.test.mjs",
    "prepack": "npm run build",
    "test:pack": "node scripts/pack-smoke.mjs",
    "build:windows": "node scripts/build-windows.mjs",
    "test:windows": "node scripts/windows-exe-smoke.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@github/copilot": "1.0.88",
    "commander": "^14.0.0",
    "cross-spawn": "^7.0.6",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xiejiayun/PilotMeter.git"
  }
}
